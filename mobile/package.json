{
  "name": "teletwin-mobile",
  "private": true,
  "description": "TeleTwin Android shell (Capacitor) that opens the hosted web app",
  "scripts": {
    "sync": "cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "aab:release": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
